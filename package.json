{
  "name": "kl-rail",
  "private": true,
  "type": "module",
  "scripts": {
    "//": "Two kinds of check: `test` asserts values measured from the shipped timetable, so a real timetable change is meant to turn it red; `check:feed` asserts only rules any correct timetable satisfies, which is what the daily refresh runs.",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "models": "node scripts/build_train_models.mjs",
    "test": "vitest run",
    "check:feed": "python scripts/check_feed.py data/network.json --self-test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/maplibre": "^9.4.0",
    "@deck.gl/mesh-layers": "^9.4.0",
    "gtfs-realtime-bindings": "^2.2.0",
    "maplibre-gl": "^6.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "image-size": "^2.0.4"
  }
}
